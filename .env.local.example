# Copy this to .env.local and fill in your values

# ── Newsletter (Resend) ──────────────────────────────────────────────────────
# Get a free API key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives new subscriber notifications
NOTIFY_EMAIL=you@apollotechnologiesus.com

# ── PicoClaw: Quick AI Post Generator ───────────────────────────────────────
# Choose your provider: "google" or "groq"
PICOCLAW_PROVIDER=google

# Google Gemini API key — https://aistudio.google.com/apikey (free tier available)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key — https://console.groq.com (very fast, generous free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenClaw: Research Post Generator (Local Ollama) ────────────────────────
# Ollama must be running locally: https://ollama.com
# Pull a model first: ollama pull llama3.2  OR  ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Admin panel (/admin) ─────────────────────────────────────────────────────
# Login for the subscribers page. Defaults are baked into the code, so set these
# in production or anyone who knows the defaults can log in.
ADMIN_EMAIL=revanaglobal@gmail.com
ADMIN_PASSWORD=change-me

# ── Subscriber storage (Upstash Redis / Vercel KV) ──────────────────────────
# Without these, subscribers go to a local data/subscribers.json file. That
# works in dev but NOT on Vercel — serverless has no writable disk, so /admin
# would always read empty. Setup: https://vercel.com/marketplace/upstash
# (Vercel dashboard → your project → Storage → Upstash → Redis → free plan).
# Vercel injects both vars automatically once connected; copy them here from
# Project → Settings → Environment Variables for local testing.
# Direct alternative: https://console.upstash.com → Create Database → REST API.
KV_REST_API_URL=https://xxxx-xxxxx-xxxxx.upstash.io
KV_REST_API_TOKEN=AXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
